<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">FocusSupervisor</string>

    <!-- 无障碍服务：这两条会原样显示在系统「无障碍」设置页里，措辞要让用户看得懂 -->
    <string name="accessibility_service_label">FocusSupervisor 监督服务</string>
    <string name="accessibility_service_description">用于识别当前打开的应用，并在你设定的规则被触发时给出提醒或拦截。开启后本服务仅在设备本地处理信息，不会上传任何内容。</string>

    <!-- 前台服务常驻通知 -->
    <string name="monitor_notification_channel_name">监督服务</string>
    <string name="monitor_notification_channel_description">保持监督能力在后台运行的常驻通知</string>
    <string name="monitor_notification_title">FocusSupervisor 正在监督</string>
    <!--
      通知正文跟着注视监控的实际状态走。这不是为了好看：Android 12+ 在摄像头被使用
      时会在状态栏亮一个绿点，用户唯一能确认「它在干什么」的地方就是这条通知。
      只写「正在监督」等于让用户自己去猜。
    -->
    <string name="monitor_notification_text_off">注视监控已暂停</string>
    <string name="monitor_notification_text_starting">正在启动摄像头…</string>
    <string name="monitor_notification_text_no_face">摄像头工作中 · 画面里没有人</string>
    <string name="monitor_notification_text_away">摄像头工作中 · 人在，但没看屏幕</string>
    <string name="monitor_notification_text_looking">摄像头工作中 · 正在注视屏幕</string>
    <string name="monitor_notification_text_error">注视监控出错，已暂停</string>

    <!-- 主动盘问通知：AI 主动开口时把话送到眼前 -->
    <string name="proactive_notification_channel_name">主动提醒</string>
    <string name="proactive_notification_channel_description">AI 主动盘问时的提醒（与「监督服务」那条常驻通知分开，可以单独关掉）</string>
    <string name="proactive_notification_title">FocusSupervisor 找你</string>
</resources>
