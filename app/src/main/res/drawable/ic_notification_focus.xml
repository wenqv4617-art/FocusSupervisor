<?xml version="1.0" encoding="utf-8"?>
<!--
  前台服务常驻通知的小图标。
  必须是单色（只用 alpha 通道着色）的 VectorDrawable —— 系统通知栏会把整张图
  按 alpha 涂成白色，带颜色的图标会变成一坨纯白方块。
  形状沿用应用图标里的「时钟指针 + 叶子」抽象：一根指针 + 一片叶子。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 竖直的指针 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M11,4 L13,4 L13,12 L11,12 Z" />

    <!-- 斜向左下的短针 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,13.6 L13.4,12.2 L8.6,17 L7.2,18.4 L5.8,17 L7.2,15.6 Z" />

    <!-- 叶子：两条外弧夹出叶形 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M18.6,4.2 C14.4,5.4 11.4,8.4 11.4,12.4 C11.4,13.6 11.8,14.6 12.4,15.4 C15.2,14.8 18.4,11.6 19.2,7.4 C19.4,6.2 19.2,5 18.6,4.2 Z" />

</vector>
