<?xml version="1.0" encoding="utf-8"?>
<!--
  网络安全配置。
  ============================================================================
  为什么需要它
  ============================================================================
  Android 9（API 28）起，targetSdk >= 28 的应用默认**禁止明文 HTTP**。而本项目
  要支持「本地 Ollama」这种跑在同一台手机上的端点（http://127.0.0.1:11434），
  不放行明文就等于这个预置永远连不上 —— 而它恰恰是唯一不需要把数据发到外网的
  选择，对监督类应用来说是最重要的一条退路。

  ============================================================================
  为什么只开这三个地址，而不是全局放开
  ============================================================================
  全局 `cleartextTrafficPermitted="true"` 会让应用对**任何**域名都可以走明文，
  包括用户的云端 API Key 所在的端点。那不是我们想要的：云端端点必须走 HTTPS。

  这里只放行三个回环地址：
    - 127.0.0.1 / localhost  本机（Termux 里跑的 Ollama、其他本机推理服务）
    - 10.0.2.2               安卓模拟器访问宿主机的固定地址

  局域网里的 http://192.168.x.x 端点**不在放行之列**。要用它有两个办法：
  给推理服务套一层 HTTPS，或者用 adb 反向代理把端口映射到 127.0.0.1。
  这是刻意的取舍 —— 「方便连局域网 HTTP」不值得用「所有云端流量都可能走明文」来换。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
